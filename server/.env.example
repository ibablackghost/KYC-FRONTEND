# Clé créée dans Didit Console > API & Webhooks
# https://docs.didit.me/getting-started/api-authentication
DIDIT_API_KEY=

# UUID du workflow KYC publié.
# Il doit enchaîner ID Verification, Liveness et Face Match.
# https://docs.didit.me/console/workflows
DIDIT_WORKFLOW_ID=

# Adresse du site Angular. Didit y renvoie le client après la CNI.
# Cette origine doit figurer dans les domaines autorisés de l'application Didit.
PUBLIC_APP_URL=http://localhost:4200

PORT=3001
